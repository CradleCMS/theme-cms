{% comment %}
responsive (dropdown menu on small screen, center menu on large screen) modified as little as possible, from daisy UI webpage
{% endcomment %}

{% assign mainNav = settings.headerLinklist | def: "menu" %}

<div class="bg-{{ settings.header_colors | def: "base-200" }} text-{{ settings.header_colors }}-content {{ settings.general_shadow }} sticky top-0 w-[100vw] z-30">
    <a class="skip-link bg-primary text-primary-content link z-10 w-full p-4 text-center" href='#main-content'>{{ 'Skip to content' | t:'default' }}</a>
    {% if settings.headerTopEnabled %}
        <div class="bg-primary text-primary-content p-2 text-center">
            {% if settings.headerTopURL %}<a href="{{ settings.headerTopURL }}">{% endif %}<p class="max-w-8xl mx-auto">{{ settings.headerTopText | t:'default' }}</p>{%if settings.headerTopURL %}</a>{% endif %}
        </div>
    {% endif %}
    <div class="navbar max-w-8xl mx-auto container max-[500px]:flex-wrap-reverse justify-between">
        <div class="navbar-start max-[500px]:w-full max-[500px]:place-content-start w-auto grow">
            {% if navigation[mainNav].links.size > 0 %}
                {% include 'siteHeaderHam' %}
            {% endif %}
            {% if settings.useLogoEnabled %}
                <a href="{{ site | url }}" class="logo">
                    <img src="/logo.png" height="{{ settings.logoHeight | def:40 }}" alt="{{ site.name }}" tabindex="0">
                </a>
            {% else %}
                <a href="/">
                    <h1>{{site.name}}</h1>
                </a>
            {% endif %}
            <ul class="menu menu-horizontal px-1 hidden lg:flex">
                {% for link in navigation[mainNav].links %}
                    {% if link.type == 'navigation' and navigation[link.param].links.size > 0 %}
                    <li class="font-semibold text-base">
                        <details>
                            <summary>{{ link.title }}</summary>
                              <ul class="p-2 mt-4 bg-base-200 text-base-content w-60 absolute shadow">
                                {% for childlink in navigation[link.param].links %}
                                    <li class="font-semibold text-base child"><a href="{{ childlink | url }}">{{ childlink.title }}</a></li>
                                {% endfor %}
                              </ul>
                        </details>
                    </li>
                    {% else %}
                    <li class="font-semibold text-base"><a href="{{ link | url }}">{{ link.title }}</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
        <div class="navbar-end gap-4 max-[500px]:w-full max-[500px]:place-content-end w-auto shrink">
            {% assign mode = settings.searchMode | default: 'searchInput' %}
            {% if mode == 'searchInput' %}
                <a-search lang="{{ lang }}" include="pages,articles" class="max-[500px]:w-full">    
                    <label class="input input-sm input-transparent px-2 focus-within:outline-none w-full rounded-md">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 opacity-50"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z">
                            </path>
                        </svg>    
                        <input type="search" name="search" placeholder="{{ 'Search' | t:'search' }}" class="text-sm" />
                    </label>
                </a-search>
            {% elsif mode == "hidden" %}

            {% else %}
                <a class="btn btn-ghost btn-circle btn-sm" href="/search">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </a>
            {% endif %} 
            {% if site.langs.size > 1 %}
            <a-lang class="hidden lg:inline">
                <select name="lang" class="select bg-transparent w-24 btn-sm" value="{{lang}}">
                    {% for l in site.langs | keys | sort %}
                    <option value="{{ l }}" {% if l == lang %}selected{% endif %}>{{languages[l] | t:'default' }}</option>
                    {% endfor %}
                </select>
            </a-lang>
            {% endif %}
            {% if settings.headerPage != empty %}
                {% let p = pages[settings.headerCtaPage] %}
                <a class="btn btn-primary btn" href="{{ p | url }}">{{ settings.headerCtaText | def:'Contact us' | t:'default' }}</a>
            {% endif %}
        </div>
    </div>
</div>
