{% if settings.pageImage %}{{ page | img_tag:"x1200",class:"absolute w-full right-0 max-h-[30vh] object-cover" }}{% endif %}
<header class="relative prose{{ settings.pageWidth }} mx-auto pt-20 pb-10">
   <h1 class="max-w-[80%]">{{ meta.h1 }}</h1>
</header>
<section class="p-4 md:p-10 prose{{ settings.pageWidth }} mx-auto relative bg-base-100">
    <div class="{{ page.format }} pb-10">
        {{ page.html }}
    </div>
    {% form 'contact' success:'Thank you for contacting us!' error:'Form contains errors, please try again!' %}{% endform %}
</section>