<div class="text-sm breadcrumbs" role="navigation" aria-label="breadcrumbs">
    <ul>
    <li><a href="/">{{ lang.home | def:'Home'}}</a></li>
    {% if template == 'blog' %}
        {% if currentTags.size > 0 %}
            <li><a href="{{ blog | url }}">{{ blog.title }}</a></li>
            <li><span>{{ currentTags | join: " + " }}</span></li>
        {% else %}
            <li><span>{{ blog.title }}</span></li>
        {% endif %}
    {% elseif template == 'article' %}
        {% assign blog = blogs[article.blog] %}
        <li><a href="{{ blog | url }}">{{ blog.title }}</a></li>
        <li><span>{{ article.meta.h1 }}</span></li>
    {% elseif template contains 'page' %}
        <li><span>{{ page.meta.h1 }}</span></li>
    {% else %}
        <li><span>{{ metaTitle }}</span></li>
    {% endif %}
    </ul>
</div>
