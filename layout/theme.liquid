<!DOCTYPE html>
<html data-theme="{{ settings.daisy-theme }}">
    <head>
        {% include 'siteHead' %}
    </head>
    <body id="{{ meta.title | handle }}" class="bg-{{ settings.body_colors | def: "base-100" }} text-{{ settings.body_colors | def: "base" }}-content flex flex-col justify-between min-h-[100vh] {% if customer %}customer-logged-in {% endif %}template-{{ template | replace: '.', ' ' | split: ' ' | first | handle }}">
        {{ 'alpine.min.js' | script_tag }}
        <div>
            {% include 'siteHeader' %}
            {% if template == "index" %}
                <div id="main-content" tabindex="-1">
                    {% if settings.header_otf_section %}
                      {% include 'indexHero' %}
                    {% endif %}
                    {% unless contentForLayout == "" %}
                      <div class="container max-w-8xl mx-auto px-2 pb-10">
                        {{ contentForLayout }}
                      </div>
                    {% endunless %}
                </div>
            {% else %}
            <div id="main-content" class="container max-w-8xl mx-auto mt-4 px-2 pb-10" tabindex="-1">
                {{ contentForLayout }}
            </div>
            {% endif %}
        </div>
        {% include 'siteFooter' %}
    </body>
    {{ 'site.js' | script_tag }}
    {% component 'alang.js' %}
    {% component 'asearch.js' %}
</html>
