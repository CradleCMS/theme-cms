<dialog id="sign-up" class="pt-10 p-4 w-md max-w-full" closedby="any">
    <button commandfor="sign-up" command="close" class="btn absolute btn-sm top-1 right-1 btn-ghost">{{ 'Close' | t }}</button>
    <div class="p-6">
        <h3 class="text-2xl text-center mb-2">{{ settings.footerButtonTitle | def:'Sign up to our newsletter' | t:'default' }}</h3>
        <p class="text-center text-md">{{ settings.footerButtonText | def:'Recieve information about our product launches and sales' | t:'default' }}</p>        
    </div>
    {% form settings.footerButtonForm.form %}{% endform %}
</dialog>