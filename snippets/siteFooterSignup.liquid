<button id="open-sign-up" command="show-modal" commandfor="sign-up" class="btn btn-lg btn-primary">{{ 'Newsletter sign up' | t:'default'  }}</button>
<dialog id="sign-up" class="pt-10 p-4 w-md max-w-full bg-primary text-primary-content rounded-box" closedby="any">
    <button  id="close-sign-up" commandfor="sign-up" command="close" class="btn absolute btn-sm btn-secondary top-1 right-1 btn-ghost">{{ 'Close' | t }}</button>
    <div class="p-6">
        <h3 class="text-2xl text-center mb-2">{{ settings.footerButtonTitle | def:'Sign up to our newsletter' | t:'default' }}</h3>
        <p class="text-center text-md">{{ settings.footerButtonText | def:'Recieve information about our product launches and sales' | t:'default' }}</p>        
    </div>
    {% form settings.footerButtonForm.form %}{% endform %}
</dialog>
<script>
const signup = document.getElementById("sign-up");
const openSignup = document.getElementById("open-sign-up");
const closeSignup = document.getElementById("close-sign-up");

// Open button opens a modal dialog
openSignup.addEventListener("click", () => {
  signup.showModal();
});

// Close button closes the dialog box
closeSignup.addEventListener("click", () => {
  signup.close();
});    
</script>