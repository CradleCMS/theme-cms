<button id="open-hamburger" @click="document.getElementById('hamburger').showModal()" command="show-modal" commandfor="hamburger" class="btn btn-ghost btn-primary lg:hidden">          
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
</button>
<dialog id="hamburger" class="pt-10 p-6 w-sm max-w-[90%] bg-base-100 text-base-content h-[100vh] top-0" closedby="any">
    <button id="close-hamburger" @click="document.getElementById('hamburger').close()" commandfor="hamburger" command="close" class="absolute top-3 right-2 p-0">
        <svg aria-hidden="true" fill="currentColor" class"hover:scale-110" width="24" height="24" viewBox="0 0 24 24">
            <g data-name="Layer 2">
            	<g data-name="close">
            		<rect width="24" height="24" transform="rotate(180 12 12)" opacity="0"/>
            		<path d="M13.41 12l4.3-4.29a1 1 0 1 0-1.42-1.42L12 10.59l-4.29-4.3a1 1 0 0 0-1.42 1.42l4.3 4.29-4.3 4.29a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l4.29-4.3 4.29 4.3a1 1 0 0 0 1.42 0 1 1 0 0 0 0-1.42z"/>
            	</g>
            </g>
        </svg>
    </button>
    <div class="">
    <ul class="space-y-4 mb-8">
      {% for link in navigation[mainNav].links %}
        {% if link.type == 'navigation' %}
          <li class="font-sm">
            <details>
              <summary class="uppercase cursor-pointer py-2">{{ link.title }}</summary>
              <ul class="pl-3 space-y-1">
                {% for childlink in navigation[link.handle].links %}
                  {% if childlink.type == 'navigation' %}
                    <li>
                      <details>
                        <summary class="cursor-pointer">{{ childlink.title }}</summary>
                        <ul class="pl-4 space-y-1">
                          {% for subchild in navigation[childlink.handle].links %}
                            <li><a href="{{ subchild | url }}">{{ subchild.title }}</a></li>
                          {% endfor %}
                        </ul>
                      </details>
                    </li>
                  {% else %}
                    <li><a href="{{ childlink | url }}">{{ childlink.title }}</a></li>
                  {% endif %}
                {% endfor %}
              </ul>
            </details>
          </li>
        {% else %}
          <li class="font-sm"><a href="{{ link | url }}">{{ link.title }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>

    {% if site.langs.size > 1 %}
      <a-lang class="block mt-4">
        <select name="lang" class="select w-full">
          {% for l in site.langs | keys | sort %}
            <option value="{{ l }}" {% if l == lang %}selected{% endif %}>
              {{ languages[l] | t:'default' }}
            </option>
          {% endfor %}
        </select>
      </a-lang>
    {% endif %}
    </div>
</dialog>
<style>
#hamburger {
    margin: 0;
    box-sizing: content-box;
}
#hamburger:open {
    animation: cart-slide-in 0.3s linear forwards;
    left: -1200px;
}
@keyframes cart-slide-in {
  to { left: 0px }
}
</style>

