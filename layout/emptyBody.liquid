<!DOCTYPE html>
<html data-theme="{{ settings.daisy-theme }}">
    <head>
        {% include 'siteHead' %}
    </head>
    <body id="{{ meta.title | handle }}" class="bg-{{ settings.body_colors | def: "base-100" }} text-{{ settings.body_colors | def: "base" }}-content flex flex-col justify-between min-h-[100vh] {% if customer %}customer-logged-in {% endif %}template-{{ template | replace: '.', ' ' | split: ' ' | first | handle }}">
        {{ 'alpine.min.js' | script_tag }}
        {% if settings.pageLandingHeader %}
          {% include 'siteHeader' %}
        {% endif %}
        {{ contentForLayout }}
        {% if settings.pageLandingFooter %}
          {% include 'siteFooter' %}
        {% endif %}
    </body>
</html>
