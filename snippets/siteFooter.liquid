<div class="bg-{{ settings.footer_colors | def: "neutral" }} text-{{ settings.footer_colors | def: "neutral" }}-content">
    <footer class="footer md:footer-horizontal lg:footer-horizontal px-4 py-10 max-w-8xl mx-auto container justify-items-center">
      <div class="justify-self-start flex flex-wrap gap-x-16 gap-y-8">
        <aside class="flex flex-col gap-8">
            {% if settings.footerImage != empty %}
                <img class="justify-self-start" src="{{ settings.footer_image_src | asset_img_url:'300','0' }}" alt="{{ settings.footer_image_alt | t:'default' }}">
            {% endif %}
            <div class="flex flex-col gap-6 max-w-md">
                {% unless settings.footer_about_shop == empty %}
                    <p class="font-bold">
                      {{ settings.footer_about_shop | t:'default' }}
                    </p> 
                {% endunless %}
                {% if settings.footer_social_enable %}
                  <div class="flex gap-6">
                    {% include 'socialmedia-icon-links' %}
                  </div>
                {% endif %}
            </div>
        </aside> 
        {% if settings.footerLinklists != empty %}
          <div class="flex gap-8">
            {% for linkList in settings.footerLinklists %}
              <nav class="flex flex-col gap-4 mt-4">
                <header class="footer-title">{{ linkList.title }}</header> 
                {% for link in navigation[linkList].links %}
                <a class="link link-hover uppercase text-xs" href="{{ link | url }}">{{ link.title }}</a>
                {% endfor %}
              </nav> 
            {% endfor %}
          </div>
        {% endif %}                 
      </div>
      <div class="place-self-stretch grid place-items-center">
        {% if settings.footerButtonForm.form %}
            <div class="max-w-xs text-center">
                <h3 class="text-2xl text-center mb-2">{{ settings.footerButtonTitle | def:'Sign up to our newsletter' | t:'default' }}</h3>
                <p class="text-center text-md mb-8">{{ settings.footerButtonText | def:'Recieve information about our product launches and sales' | t:'default' }}</p>
                {% include 'siteFooterSignup' %}                
            </div>
        {% endif %}
      </div>
    </footer>
    <footer class="footer-horizontal p-4 max-w-8xl mx-auto container">
        <p class="text-sm">Copyright &copy; {{ site.name }} - {{ 'All rights reserved' | t:'default' }}</p>
    </footer>
</div>
